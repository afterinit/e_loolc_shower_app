<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/code_action"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/renew_code"
            android:src="@drawable/ic_refresh"
            android:tooltipText="@string/renew_code"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/theme_toggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/show_day_theme"
            android:src="@drawable/ic_sun" />

        <ImageButton
            android:id="@+id/sign_out"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/sign_out"
            android:src="@drawable/ic_sign_out"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/toolbar_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <ScrollView
        android:id="@+id/content_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <FrameLayout
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true">

            <LinearLayout
                android:id="@+id/card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="24dp"
                android:orientation="vertical"
                android:padding="26dp">

                <TextView
                    android:id="@+id/login_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/login_title"
                    android:textSize="27sp" />

                <TextView
                    android:id="@+id/campus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/campus"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/login_form"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/account_label"
                        style="@style/Widget.Shower.Label"
                        android:labelFor="@+id/account"
                        android:text="@string/account_label" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@id/account"
                        style="@style/Widget.Shower.Input"
                        android:autofillHints="username"
                        android:hint="@string/account_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textNoSuggestions"
                        android:maxLength="100"
                        android:nextFocusForward="@+id/password" />

                    <TextView
                        android:id="@+id/password_label"
                        style="@style/Widget.Shower.Label"
                        android:labelFor="@id/password"
                        android:text="@string/password_label" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@id/password"
                            style="@style/Widget.Shower.Input"
                            android:autofillHints="password"
                            android:hint="@string/password_hint"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLength="200"
                            android:paddingStart="12dp"
                            android:paddingEnd="68dp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/toggle_password"
                            android:layout_width="60dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="end"
                            android:padding="0dp"
                            android:text="@string/show_password"
                            android:textAllCaps="false"
                            android:textSize="12sp" />
                    </FrameLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/sign_in"
                        style="@style/Widget.Shower.Button"
                        android:text="@string/sign_in" />

                    <TextView
                        android:id="@+id/login_session_notice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/login_session_notice"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/login_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:accessibilityLiveRegion="polite"
                    android:padding="11dp"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="24dp"
                android:paddingEnd="22dp"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/code_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/code_surface"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="18dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp">

                            <TextView
                                android:id="@+id/code_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/current_code"
                                android:textSize="13sp" />

                            <ImageButton
                                android:id="@+id/code_visibility"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@string/reveal_code"
                                android:src="@drawable/ic_eye" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/code_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:autoSizeMaxTextSize="46sp"
                            android:autoSizeMinTextSize="18sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:fontFamily="monospace"
                            android:gravity="start|center_vertical"
                            android:letterSpacing="0.07"
                            android:maxLines="1"
                            android:minHeight="66dp"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:paddingBottom="10dp"
                            android:textSize="46sp" />

                        <View
                            android:id="@+id/code_rule"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="18dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="18dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="18dp"
                            android:paddingBottom="12dp">

                            <TextView
                                android:id="@+id/countdown_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:text="@string/remaining_time"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/countdown_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:accessibilityLiveRegion="none"
                                android:fontFamily="monospace"
                                android:gravity="end"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/generated_at"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/progress_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/progress_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/loading_code"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:padding="12dp"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
